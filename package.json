{
  "name": "effect-auth",
  "version": "0.1.0",
  "description": "An Effect-native authentication library: sessions, email/password and OAuth, built on Effect v4 primitives.",
  "license": "MIT",
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./passkeys": "./src/passkeys/index.ts",
    "./client": "./src/client/index.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/sqlite": "./src/testing/sqlite/index.ts",
    "./testing/postgres": "./src/testing/postgres/index.ts",
    "./testing/mysql": "./src/testing/mysql/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./passkeys": {
        "types": "./dist/passkeys/index.d.ts",
        "default": "./dist/passkeys/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "./testing/sqlite": {
        "types": "./dist/testing/sqlite/index.d.ts",
        "default": "./dist/testing/sqlite/index.js"
      },
      "./testing/postgres": {
        "types": "./dist/testing/postgres/index.d.ts",
        "default": "./dist/testing/postgres/index.js"
      },
      "./testing/mysql": {
        "types": "./dist/testing/mysql/index.d.ts",
        "default": "./dist/testing/mysql/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "build": "tsc -b tsconfig.build.json",
    "check": "oxlint --type-aware --type-check && tsc -b tsconfig.build.json",
    "fix": "oxlint --type-aware --fix && oxlint --type-aware --fix && oxfmt .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --maxWorkers=4",
    "test:sqlite": "EFFECT_AUTH_TEST_DATABASE=sqlite vitest run --maxWorkers=4",
    "test:pg": "EFFECT_AUTH_TEST_DATABASE=pg vitest run --maxWorkers=4",
    "test:mysql": "EFFECT_AUTH_TEST_DATABASE=mysql vitest run --maxWorkers=4",
    "prepack": "pnpm build",
    "prepublishOnly": "node scripts/prepublish-guard.mjs"
  },
  "dependencies": {
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@effect/sql-mysql2": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/sql-pglite": "4.0.0-rc.112",
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "@effect/tsgo": "0.38.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@simplewebauthn/server": "13.3.3",
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^22.10.2",
    "effect": "4.0.0-rc.112",
    "lefthook": "2.1.12",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@effect/sql-mysql2": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/sql-pglite": "4.0.0-rc.112",
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "@simplewebauthn/server": "^13.0.0",
    "@testcontainers/mysql": "^12.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "effect": "4.0.0-rc.112"
  },
  "peerDependenciesMeta": {
    "@effect/sql-mysql2": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    },
    "@effect/sql-pglite": {
      "optional": true
    },
    "@effect/sql-sqlite-node": {
      "optional": true
    },
    "@simplewebauthn/server": {
      "optional": true
    },
    "@testcontainers/mysql": {
      "optional": true
    },
    "@testcontainers/postgresql": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.3"
}
