{
  "name": "effect-auth",
  "version": "0.1.0",
  "description": "An Effect-native authentication library: sessions, email/password and OAuth, built on Effect v4 primitives.",
  "license": "MIT",
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "build": "tsc -b tsconfig.build.json",
    "check": "oxlint --type-aware --type-check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --maxWorkers=2",
    "prepack": "pnpm build",
    "prepublishOnly": "node scripts/prepublish-guard.mjs"
  },
  "dependencies": {
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@effect/sql-pglite": "4.0.0-rc.112",
    "@effect/tsgo": "^0.38.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^22.10.2",
    "effect": "4.0.0-rc.112",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@effect/sql-pglite": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "peerDependenciesMeta": {
    "@effect/sql-pglite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.3"
}
