{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "plugins": ["effecttsgo", "typescript", "import", "oxc", "eslint", "unicorn", "node"],
  "options": { "typeAware": true },

  // `pedantic` and `restriction` are excluded on purpose: oxlint ships them as
  // mutually-contradictory opt-ins (one-var, sort-keys, no-magic-numbers,
  // import/no-named-export). Turning them on is noise, not strictness.
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },

  "rules": {
    // ==================================================================
    // Effect — all 96 rules @effect/tsgo ships, listed explicitly.
    //
    // Effect's own `recommended` preset calibrates 82 of these (13 error,
    // 69 warn) and excludes 14 outright. We run stricter than that on
    // purpose — error is the default here — but the four `warn` entries and
    // two `off` entries in this block (a third `off`, typescript/consistent-return,
    // lives in the core block below) are the rules where the audit found the
    // preset was right and blanket-error cost ergonomics with no safety
    // gain. See SPEC.md Amendment 18 for the per-rule rationale.
    // ==================================================================
    "effecttsgo/abort-controller-in-effect": "error",
    "effecttsgo/any-unknown-in-error-context": "error",
    // warn: `recommended` warns. An `async` function at a genuine platform
    // boundary (jose, WebCrypto, the PGlite driver) is the correct code, so
    // this is a prompt to look, not a defect.
    "effecttsgo/async-function": "warn",
    "effecttsgo/catch-all-to-map-error": "error",
    "effecttsgo/catch-chain-to-first-success-of": "error",
    // warn: `recommended` warns. The rewrite to `catchIf` is a readability
    // preference; at error it forced refactors of catch blocks whose
    // conditional refail was already the clearer form.
    "effecttsgo/catch-conditional-refail-to-catch-if": "warn",
    "effecttsgo/catch-tag-to-catch-reason": "error",
    "effecttsgo/catch-to-ignore": "error",
    "effecttsgo/catch-to-or-else-succeed": "error",
    "effecttsgo/catch-unfailable-effect": "error",
    "effecttsgo/class-self-mismatch": "error",
    "effecttsgo/crypto-random-uuid": "error",
    "effecttsgo/crypto-random-uuid-in-effect": "error",
    // off: excluded from `recommended`. Its key-naming scheme is a house
    // style, not a correctness property. The service-key renames it prompted
    // are kept (they are wire-visible and already shipped); only the standing
    // rule goes, so future keys are chosen for the wire, not for the linter.
    "effecttsgo/deterministic-keys": "off",
    "effecttsgo/duplicate-package": "error",
    "effecttsgo/effect-do-notation": "error",
    "effecttsgo/effect-fn-iife": "error",
    "effecttsgo/effect-fn-implicit-any": "error",
    "effecttsgo/effect-fn-opportunity": "error",
    "effecttsgo/effect-gen-uses-adapter": "error",
    "effecttsgo/effect-in-failure": "error",
    "effecttsgo/effect-in-void-success": "error",
    "effecttsgo/effect-map-flatten": "error",
    "effecttsgo/effect-map-void": "error",
    "effecttsgo/effect-succeed-with-void": "error",
    "effecttsgo/extends-native-error": "error",
    "effecttsgo/flat-map-to-map": "error",
    "effecttsgo/floating-effect": "error",
    "effecttsgo/floating-effect-in-vitest": "error",
    "effecttsgo/generic-effect-services": "error",
    "effecttsgo/global-console": "error",
    "effecttsgo/global-console-in-effect": "error",
    // warn (both): `recommended` warns. `DateTime`/`Clock` is right inside an
    // Effect, but `Date` in a pure helper, a type-level default or a doc
    // example is not a defect, and at error the rule reached all of them.
    "effecttsgo/global-date": "warn",
    "effecttsgo/global-date-in-effect": "warn",
    "effecttsgo/global-error-in-effect-catch": "error",
    "effecttsgo/global-error-in-effect-failure": "error",
    "effecttsgo/global-fetch": "error",
    "effecttsgo/global-fetch-in-effect": "error",
    "effecttsgo/global-random": "error",
    "effecttsgo/global-random-in-effect": "error",
    "effecttsgo/global-timers": "error",
    "effecttsgo/global-timers-in-effect": "error",
    "effecttsgo/instance-of-schema": "error",
    "effecttsgo/layer-merge-all-with-dependencies": "error",
    "effecttsgo/lazy-effect": "error",
    "effecttsgo/lazy-promise-in-effect-sync": "error",
    "effecttsgo/leaking-requirements": "error",
    "effecttsgo/missed-pipeable-opportunity": "error",
    "effecttsgo/missing-effect-context": "error",
    "effecttsgo/missing-effect-error": "error",
    "effecttsgo/missing-effect-service-dependency": "error",
    "effecttsgo/missing-layer-context": "error",
    // off: excluded from `recommended`. It demands a data-last `dual()`
    // overload on every exported combinator; satisfying it added 69 dead
    // overloads no caller in the library or its examples ever used.
    "effecttsgo/missing-pipeable-signature": "off",
    "effecttsgo/missing-return-yield-star": "error",
    "effecttsgo/missing-star-in-yield-effect-gen": "error",
    "effecttsgo/multiple-catch-tag": "error",
    "effecttsgo/multiple-effect-provide": "error",
    "effecttsgo/nested-effect-gen-yield": "error",
    "effecttsgo/new-promise": "error",
    "effecttsgo/new-schema-class": "error",
    "effecttsgo/node-builtin-import": "error",
    "effecttsgo/non-object-effect-service-type": "error",
    "effecttsgo/outdated-api": "error",
    "effecttsgo/overridden-schema-constructor": "error",
    "effecttsgo/prefer-schema-over-json": "error",
    "effecttsgo/prefer-schema-type-property": "error",
    "effecttsgo/prefer-typed-schema-decoder": "error",
    "effecttsgo/prefer-unsafe-constructor": "error",
    "effecttsgo/process-env": "error",
    "effecttsgo/process-env-in-effect": "error",
    "effecttsgo/promise-in-effect-success": "error",
    "effecttsgo/redundant-map-error": "error",
    "effecttsgo/redundant-or-die": "error",
    "effecttsgo/redundant-schema-tag-identifier": "error",
    "effecttsgo/return-effect-in-gen": "error",
    "effecttsgo/run-effect-inside-effect": "error",
    "effecttsgo/schema-literal-non-finite": "error",
    "effecttsgo/schema-number": "error",
    "effecttsgo/schema-opaque-instance-member": "error",
    "effecttsgo/schema-struct-with-tag": "error",
    "effecttsgo/schema-sync-in-effect": "error",
    "effecttsgo/schema-union-of-literals": "error",
    "effecttsgo/scope-in-layer-effect": "error",
    "effecttsgo/service-not-as-class": "error",
    "effecttsgo/strict-boolean-expressions": "error",
    "effecttsgo/strict-effect-provide": "error",
    "effecttsgo/sync-to-succeed": "error",
    "effecttsgo/try-catch-in-effect-gen": "error",
    "effecttsgo/unknown-in-effect-catch": "error",
    "effecttsgo/unnecessary-arrow-block": "error",
    "effecttsgo/unnecessary-effect-gen": "error",
    "effecttsgo/unnecessary-fail-yieldable-error": "error",
    "effecttsgo/unnecessary-pipe": "error",
    "effecttsgo/unnecessary-pipe-chain": "error",
    "effecttsgo/unnecessary-typeof-type": "error",
    "effecttsgo/unsafe-effect-type-assertion": "error",

    // ==================================================================
    // Core oxlint. The `off` entries below are Effect's own base config
    // (packages/tools/oxc/oxlintrc.json) — rules that fight Effect's
    // idioms rather than finding defects. Each is a standing decision,
    // not a dodge; anything not listed here stays on at error.
    // ==================================================================

    // `_tag` / `_id` / `_op` are Effect's data model, not private-name hacks.
    "eslint/no-underscore-dangle": "off",
    // Effect.gen bodies may legitimately never yield (assert-only, or constant).
    "eslint/require-yield": "off",
    // Superseded by the type-aware typescript/no-unused-vars below.
    "eslint/no-unused-vars": "off",
    // Shadowing inside pipe/gen chains is idiomatic and locally obvious.
    "eslint/no-shadow": "off",
    "eslint/no-fallthrough": "off",
    "eslint/no-await-in-loop": "off",
    "oxc/no-map-spread": "off",
    "unicorn/no-new-array": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-set-has": "off",
    // Effect's type-level API depends on all of these shapes.
    "typescript/no-explicit-any": "off",
    "typescript/no-empty-interface": "off",
    "typescript/no-empty-object-type": "off",
    "typescript/no-namespace": "off",
    "typescript/no-invalid-void-type": "off",
    "typescript/no-unsafe-function-type": "off",
    "typescript/unified-signatures": "off",
    "typescript/no-non-null-assertion": "off",
    "typescript/no-dynamic-delete": "off",
    "typescript/no-confusing-non-null-assertion": "off",
    // `@ts-expect-error` is load-bearing in the negative type tests.
    "typescript/ban-ts-comment": "off",
    // A guard clause that returns early and a tail that returns a value is
    // the normal shape of an Effect handler. The rule's fix is an explicit
    // `return undefined`, which the type system already knows and which
    // reads as an oversight; it found no defect in the whole tree.
    "typescript/consistent-return": "off",

    // Enabled beyond the categories above.
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/array-type": ["error", { "default": "generic", "readonly": "generic" }],
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-empty-named-blocks": "error",
    "eslint/no-console": "error",
    "eslint/no-var": "error",
    "eslint/no-useless-constructor": "error",
    "eslint/no-unneeded-ternary": "error",
    "eslint/no-useless-concat": "error",
    "oxc/misrefactored-assign-op": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/no-accessor-recursion": "error"
  },

  "ignorePatterns": ["dist", "node_modules"],

  "overrides": [
    {
      // scripts/ holds plain Node .mjs tooling that runs under bare `node` outside
      // any Effect runtime (prepublish-guard runs during `npm publish`, before the
      // package is even installed). Effect's logging and Schema APIs are not
      // reachable there, so the Effect rules cannot apply. Effect's own repo
      // carves scripts/ out the same way.
      "files": ["scripts/**"],
      "rules": {
        "effecttsgo/global-console": "off",
        "effecttsgo/strict-boolean-expressions": "off",
        // node:child_process / node:fs / node:path are the only APIs there are
        // here; the @effect/platform equivalents need a runtime this code runs
        // before (prepare.mjs is what patches the toolchain in the first place).
        "effecttsgo/node-builtin-import": "off",
        "eslint/no-console": "off"
      }
    },
    {
      // Tests and the test kit are entry points, not library code. Several of
      // these rules say so in their own message ("disable this rule in tests").
      // A test is allowed to construct a fixed Date, a literal UUID, a JSON
      // blob or a bare `async` helper — that is the arrangement the assertion
      // is about, and routing it through Clock/Schema/Random would replace the
      // thing under test with the thing being tested against.
      "files": ["test/**", "src/testing/**"],
      "rules": {
        // A test provides exactly the layers its subject needs, by hand.
        "effecttsgo/strict-effect-provide": "off",
        // No test helper is a public combinator; dual() overloads are dead weight.
        "effecttsgo/missing-pipeable-signature": "off",
        // Fixtures and wire-format assertions are literal JSON on purpose.
        "effecttsgo/prefer-schema-over-json": "off",
        "effecttsgo/crypto-random-uuid": "off",
        "effecttsgo/crypto-random-uuid-in-effect": "off",
        // Fixed timestamps are how a time-dependent assertion is made stable.
        "effecttsgo/global-date": "off",
        "effecttsgo/global-date-in-effect": "off",
        "effecttsgo/async-function": "off",
        // A lazily-constructed Effect in a fixture is a fixture, not a bug.
        "effecttsgo/lazy-effect": "off",
        "effecttsgo/deterministic-keys": "off",
        // Assertion messages and snapshot labels stringify freely.
        "typescript/no-base-to-string": "off",
        "typescript/restrict-template-expressions": "off",
        // Test-kit generics are written for the call site, not for inference.
        "typescript/no-unnecessary-type-parameters": "off"
      }
    }
  ]
}
